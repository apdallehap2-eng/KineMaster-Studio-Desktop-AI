{
  "name": "kinemaster-studio-desktop-ai",
  "productName": "KineMaster Studio v8.1.15 AI",
  "version": "8.1.15",
  "description": "KineMaster Studio Desktop AI Edition",
  "main": "main.js",
  "author": "KineMaster Studio",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win32": "electron-builder --win nsis --ia32"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "23.6.0"
  },
  "build": {
    "appId": "com.kinemaster.studio.desktopai",
    "productName": "KineMaster Studio v8.1.15 AI",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "index1.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ],
      "artifactName": "KineMaster-Studio-AI-Setup-${version}-Win32.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KineMaster Studio v8.1.15 AI",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
